# Copy to .env and fill in. Never commit .env.
# Get a key in the Panta API Playground (API keys tab).
# NOTE: pk_test_ keys return a single sandbox fixture market; use pk_live_ for the real catalog.
PANTA_API_KEY=pk_live_your_key_here
# Optional (default shown):
# PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
# PANTA_RADAR_DB=data/radar.db
